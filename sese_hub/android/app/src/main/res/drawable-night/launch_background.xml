<?xml version="1.0" encoding="utf-8"?>
<!-- Dark-mode native splash: plain #121212 fill (matches SeSe dark scaffold).
     The branded SeSe logo + animation lives in the Flutter SeSeSplashScreen
     (which follows the system theme), so the native window just needs a
     matching dark background to avoid any flash during engine boot in dark
     mode. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background_color" />
</layer-list>
