<?xml version="1.0" encoding="utf-8"?>
<!-- Light-mode native splash: plain white fill.
     The branded SeSe logo + animation lives in the Flutter SeSeSplashScreen
     (which follows the system theme), so the native window just needs a
     matching solid background to avoid any flash during engine boot. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background_color" />
</layer-list>
