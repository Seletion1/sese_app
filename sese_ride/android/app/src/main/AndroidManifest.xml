<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Map tiles, geocoding, directions, Firebase (required in release;
         debug/profile manifests also declare it for the Flutter tool). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Driver live-map positioning (OpenStreetMap layer + zero-trust GPS fix). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Voice notes in Support Chat and In-App VoIP audio calls. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Scoped contacts access: used ONLY when the user taps the Contacts icon
         next to a recipient phone field to select a contact from their device.
         The app reads ONLY the chosen contact's name + number; the full address
         book is never uploaded, stored, or transmitted. Disclosed via
         ContactsDisclosureDialog BEFORE the OS permission prompt. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Camera for KYC selfies, live plate snapshot, and chat attachments.
         Gallery/photo library access uses the Android system Photo Picker
         which needs zero permissions — explicitly block any third-party merge. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />
    <!-- ACCESS_BACKGROUND_LOCATION removed: Google Play policy requires background
         location declaration which creates policy overhead. Foreground location
         (ACCESS_FINE_LOCATION) is sufficient: GPS fixes continue when the driver
         actively navigates, and the app refreshes on resume. The overlay bubble
         keeps the app in foreground during active trips so background access is
         not needed. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" tools:node="remove" />
    <!-- FOREGROUND_SERVICE_LOCATION removed: Google Play Console requires a
         declaration form for FOREGROUND_SERVICE_LOCATION which we cannot satisfy
         without background location. OverlayService foregroundServiceType is
         changed to specialUse (stripped below) so no location FGS type is declared. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" tools:node="remove" />
    <!-- Floating quick-return bubble / OverlayService stripped to eliminate
         Google Play Foreground Service declaration requirements and avoid
         Android 14+ MissingForegroundServiceTypeException runtime crashes.
         Driver notifications are delivered via high-priority heads-up alerts. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" tools:node="remove" />
    <!-- Heads-up order & call alerts with wake-lock; USE_FULL_SCREEN_INTENT explicitly removed
         for Google Play policy compliance (heads-up notifications with Accept/Decline actions used instead). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" tools:node="remove" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Advertising ID stripped to eliminate Google Play Sensitive Permissions declaration requirements. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove" />
    <application
        android:label="sese_ride"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true">
        <!-- Default notification channel for FCM background notifications -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="sese_orders" />

        <!-- OverlayService stripped: eliminating it removes the FOREGROUND_SERVICE
             permission merged by flutter_overlay_window, guaranteeing zero
             Foreground Service declaration gates in Google Play Console. -->
        <service
            android:name="flutter.overlay.window.flutter_overlay_window.OverlayService"
            tools:node="remove" />

        <!-- GeolocatorLocationService from geolocator_android is stripped entirely:
             it is only needed for background foreground-service location tracking,
             which is removed in this release. Foreground Geolocator.getCurrentPosition()
             and getPositionStream() work without this service when the app is active.
             Removing it eliminates the FOREGROUND_SERVICE_LOCATION declaration gate
             in Google Play Console. -->
        <service
            android:name="com.baseflow.geolocator.GeolocatorLocationService"
            tools:node="remove" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Android App Links for domain verification with sesetech.com and sese-ride.web.app -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="sesetech.com" />
                <data android:scheme="https" android:host="www.sesetech.com" />
                <data android:scheme="https" android:host="sese-ride.web.app" />
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Google Maps SDK (browsing/idle surfaces via google_maps_flutter).
             Key is injected at build time from local.properties
             (GOOGLE_MAPS_SDK_KEY=AIza...) and is NEVER hardcoded here.
             Restrict this key in Cloud Console to the Android app package +
             Maps SDK for Android. SHA-1 fingerprint restriction must cover
             both debug and release keystores. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${GOOGLE_MAPS_SDK_KEY}" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <!-- Phone dialing and SMS intents (required for url_launcher on Android 11+) -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="sms" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- External navigation app intents: Google Maps, Waze, and system GPS apps -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="geo"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="google.navigation"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https" android:host="maps.google.com"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https" android:host="waze.com"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https" android:host="maps.apple.com"/>
        </intent>
        <package android:name="com.google.android.apps.maps" />
        <package android:name="com.waze" />
    </queries>
</manifest>
