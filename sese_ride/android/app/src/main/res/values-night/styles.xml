<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Android Window while the process is starting
         when the OS Dark Mode setting is ON (dark mode).
         Uses Theme.Black so the status-bar icons are light on dark. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <!-- Plain dark fill (#121212) — the branded SeSe splash runs in Flutter. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/launch_background_color</item>
        <item name="android:navigationBarColor">@color/launch_background_color</item>
    </style>

    <!-- Theme applied as soon as the Flutter process has started (dark mode). -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background_color</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
