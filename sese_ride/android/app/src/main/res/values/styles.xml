<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Android Window while the process is starting
         when the OS Dark Mode setting is OFF (light mode).
         Uses Theme.Light so the status-bar icons are dark on white. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- Plain white fill — the branded SeSe splash runs in Flutter. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/launch_background_color</item>
        <item name="android:navigationBarColor">@color/launch_background_color</item>
    </style>

    <!-- Theme applied as soon as the Flutter process has started (light mode).
         The window background shows behind Flutter while it initialises. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background_color</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
