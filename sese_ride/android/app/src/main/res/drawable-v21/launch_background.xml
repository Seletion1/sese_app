<?xml version="1.0" encoding="utf-8"?>
<!-- API 21+ light-mode native splash: plain white fill.
     The branded SeSe logo + animation lives in the Flutter SeSeSplashScreen,
     so the native window just needs a matching solid background to avoid
     the black flash during engine boot. -->
